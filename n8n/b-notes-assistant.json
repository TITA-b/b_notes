    {
      "parameters": {
        "jsCode": "const webhookBody = $('Webhook B_Notes').first().json.body;\nconst transcribed = $input.first().json.text || '';\nreturn [{ json: { ...webhookBody, userMessage: transcribed } }];"
      },
      "id": "c90897b2-7bb6-4a10-8e69-15b9748ade39",
