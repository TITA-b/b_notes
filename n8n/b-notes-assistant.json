      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'openai/gpt-oss-20b', temperature: 0.3, response_format: { type: 'json_object' }, messages: [{ role: 'system', content: 'Sos el asistente de B_Notes. Respondé SIEMPRE en JSON con el formato: {\"reply\": \"tu respuesta en markdown\", \"transcript\": \"opcional\", \"actions\": []}. Acciones válidas en actions: {\"type\": \"create_task\", \"title\": \"...\", \"dueDate\": \"ISO opcional\", \"area\": \"slug\"}, {\"type\": \"create_note\", \"title\": \"...\", \"content\": \"...\", \"area\": \"slug\"}, {\"type\": \"append_to_note\", \"noteId\": \"id\", \"content\": \"...\"}, {\"type\": \"create_gcal_event\", \"title\": \"...\", \"start\": \"ISO\"}. Contexto actual: ' + JSON.stringify($json.context) }, ...($json.history || []), { role: 'user', content: $json.userMessage }] }) }}",
        "options": {}
      },
      "id": "67a34239-928f-43fe-a9b7-b1de072ad058",
      "name": "Groq LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        16
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "wA3KMLXGIC6Gxbn5",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices?.[0]?.message?.content || '{}';\nlet parsed = {};\ntry { parsed = JSON.parse(raw); } catch { parsed = { reply: raw, actions: [] }; }\nconst transcript = $('Unir Transcripcion').isExecuted ? $('Unir Transcripcion').first().json.userMessage : undefined;\nreturn [{ json: { reply: parsed.reply || 'Listo.', transcript, actions: Array.isArray(parsed.actions) ? parsed.actions : [] } }];"
      },
      "id": "7742f4d4-984e-4db0-9f86-9ad732136514",
