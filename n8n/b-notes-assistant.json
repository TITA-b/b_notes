    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst buffer = Buffer.from(body.audioBase64, 'base64');\nreturn [{\n  json: body,\n  binary: {\n    file: {\n      data: buffer.toString('base64'),\n      mimeType: body.audioMimeType || 'audio/webm',\n      fileName: 'audio.webm'\n    }\n  }\n}];"
      },
