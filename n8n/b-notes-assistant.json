      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nreturn [{ json: { ...body, userMessage: body.message || '' } }];"
      },
      "id": "cebcc2a2-c9f3-4dd1-8340-0bddb751da07",
      "name": "Preparar Texto",
      "type": "n8n-nodes-base.code",
